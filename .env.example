# ============================================================
#  Environment — salin file ini jadi `.env` lalu sesuaikan.
#  `.env` sudah di-ignore oleh git, JANGAN pernah di-commit.
#  Semua variabel di sini opsional — kalau kosong, aplikasi
#  jalan dengan default (mock API aktif).
# ============================================================

# ------------------------------------------------------------
#  BACKEND
# ------------------------------------------------------------

# Base URL Laravel backend (CUKLIZ/Ajem-UDINUS-BE).
#
# Sengaja TIDAK `NUXT_PUBLIC_*`: nilai ini hanya dibaca di server, tidak pernah
# dikirim ke browser. Browser memanggil `/api/v1/*` di origin yang sama dan
# route catch-all yang meneruskannya ke Laravel. Konsekuensinya: tidak ada CORS
# dan URL backend tidak bocor ke devtools.
NUXT_API_BASE=http://127.0.0.1:8000

# true  = pakai mock API bawaan (server/utils/mockApi), app jalan mandiri
# false = panggil Laravel sungguhan
# HARUS string persis "false" untuk mematikan mock
NUXT_PUBLIC_USE_MOCK=true

# ------------------------------------------------------------
#  APLIKASI
# ------------------------------------------------------------

# URL publik aplikasi
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Nama aplikasi & mata uang (default: Ansian / IDR)
#NUXT_PUBLIC_APP_NAME=Ansian
#NUXT_PUBLIC_CURRENCY=IDR

# ------------------------------------------------------------
#  REALTIME — Laravel Reverb / Soketi / Pusher
#  Defaultnya NONAKTIF. Nyalakan hanya kalau backend websocket sudah jalan.
# ------------------------------------------------------------

NUXT_PUBLIC_REALTIME_ENABLED=false

# App key Pusher/Reverb (dari backend)
NUXT_PUBLIC_REALTIME_KEY=

# Host & port websocket
NUXT_PUBLIC_REALTIME_HOST=localhost
NUXT_PUBLIC_REALTIME_PORT=8080
NUXT_PUBLIC_REALTIME_WSS_PORT=8081

# true kalau pakai wss:// (produksi / HTTPS)
NUXT_PUBLIC_REALTIME_TLS=false

# Cluster Pusher
NUXT_PUBLIC_REALTIME_CLUSTER=mt1
